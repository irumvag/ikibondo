# Ikibondo backend environment variables.
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
#
#   cp backend/.env.example backend/.env
#
# Choose the settings module per environment:
#   DJANGO_SETTINGS_MODULE=config.settings.dev     (local, Postgres, DEBUG)
#   DJANGO_SETTINGS_MODULE=config.settings.sqlite   (quick local, SQLite)
#   DJANGO_SETTINGS_MODULE=config.settings.prod     (production, strict)

# ── Core / security (REQUIRED in production) ─────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-in-production
# Comma-separated hostnames. Required by prod.py (no default).
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=ikibondo
DB_USER=ikibondo
# prod.py requires this (no fallback). Use a strong, unique value in production.
DB_PASSWORD=ikibondo
DB_HOST=localhost
DB_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────
# In docker-compose the host is the service name, e.g. redis://redis:6379/0
# If Redis auth is enabled: redis://:PASSWORD@redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Frontend / email ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=Ikibondo <noreply@ikibondo.rw>
SERVER_EMAIL=noreply@ikibondo.rw
# Production SMTP (prod.py):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Error tracking (optional) ────────────────────────────────────────────
SENTRY_DSN=

# ── SMS — Africa's Talking (optional) ────────────────────────────────────
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ── Push — Firebase Cloud Messaging (optional) ───────────────────────────
FCM_SERVER_KEY=

# ── DHIS2 / Rwanda HMIS sync (optional; sync is a no-op when URL is blank) ─
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# Metadata UIDs — override per DHIS2 deployment (defaults are placeholders).
DHIS2_PROGRAM_UID=
DHIS2_TE_TYPE_UID=
DHIS2_ORG_UNIT_UID=
DHIS2_ATTR_REG_NUMBER=
DHIS2_ATTR_FULL_NAME=
DHIS2_ATTR_DOB=
DHIS2_ATTR_SEX=
DHIS2_ATTR_CAMP=
DHIS2_DE_VACCINE=
DHIS2_DE_VAX_STATUS=
DHIS2_DE_BATCH=
